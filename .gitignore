# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at build time
/generated
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# local backups of data dropped from the database
/.backup

# impeccable's own per-machine edit cache — accumulates across sessions and
# changes on nearly every edit, unlike the design sidecar/config next to it
.impeccable/hook.cache.json
